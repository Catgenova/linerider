<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <!-- dotnet build -p:InputSystem=true compiles the Input System package code path instead of the legacy one. -->
  <PropertyGroup Condition="'$(InputSystem)' == 'true'">
    <DefineConstants>$(DefineConstants);ENABLE_INPUT_SYSTEM;CYBER_INPUT_SYSTEM</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(InputSystem)' != 'true'">
    <DefineConstants>$(DefineConstants);ENABLE_LEGACY_INPUT_MANAGER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/Scripts/Unity/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../UnityStubs/UnityStubs.csproj" />
  </ItemGroup>
</Project>
