{
  "name": "cyber-rider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cyber Rider: a neon cyberpunk rebuild of Line Rider with campaign, puzzle, and arcade modes.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:standalone": "npm run build && node scripts/standalone.mjs",
    "pages": "npm run build && node scripts/standalone.mjs ../index.html"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
